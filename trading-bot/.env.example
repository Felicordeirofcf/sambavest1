# Copie para .env e preencha. NUNCA faça commit do .env.
# Crie a chave em Binance > Gerenciamento de API com:
#   - "Habilitar Leitura" + "Habilitar Spot & Margin Trading"
#   - SAQUE DESABILITADO
#   - Restrição de IP (somente o IP da máquina que roda o robô)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Testnet (dinheiro fictício): https://testnet.binance.vision
# Produção: https://api.binance.com
BINANCE_BASE_URL=https://testnet.binance.vision

# true = só simula (não envia ordens). Mude para false conscientemente.
DRY_RUN=true

QUOTE_ASSET=USDT
TAKE_PROFIT_PCT=2.0        # lucro LÍQUIDO alvo por operação (já descontando taxas)
STOP_LOSS_PCT=1.5          # perda máxima por operação
FEE_PCT=0.1                # taxa spot por lado (0.075 se paga taxa com BNB)
RISK_PER_TRADE_PCT=1.0     # % do saldo arriscado por operação (define o tamanho)
MAX_POSITION_QUOTE=100     # teto em USDT por operação
MAX_OPEN_POSITIONS=1
MAX_HOLD_HOURS=48          # fecha a mercado se não bater alvo/stop nesse tempo
DAILY_MAX_LOSS_PCT=3.0     # pausa novas entradas no dia se perder isso
MIN_24H_VOLUME_QUOTE=50000000
TOP_N_SYMBOLS=40
SCAN_INTERVAL_SEC=300
