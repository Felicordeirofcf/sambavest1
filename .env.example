# Copie este arquivo para .env.local e preencha com os seus dados.
# .env.local nunca é commitado (já está no .gitignore).

# --- WhatsApp (usado no botão flutuante, no carrinho, no checkout e no rodapé) ---
# Número no formato internacional, só dígitos: 55 + DDD + número.
NEXT_PUBLIC_WHATSAPP_NUMBER=5521996959903
# Como o número aparece formatado para o cliente (texto livre).
NEXT_PUBLIC_WHATSAPP_DISPLAY="(21) 99695-9903"
# E-mail de contato exibido no rodapé e na página de contato.
NEXT_PUBLIC_CONTACT_EMAIL=adm@sambavest.com

# --- Nuvemshop (opcional) ---
# A vitrine funciona hoje com o catálogo estático em lib/products.ts, sem precisar
# de nenhuma chave abaixo. Se no futuro você conectar uma loja Nuvemshop de verdade
# e quiser puxar produtos reais de lá (lib/nuvemshop.ts), preencha:
NEXT_PUBLIC_NUVEMSHOP_STORE_ID=
NUVEMSHOP_ACCESS_TOKEN=
NUVEMSHOP_USER_AGENT="SambaVestApp (adm@sambavest.com)"

# =====================================================================
# AUTOMAÇÕES (veja AUTOMACAO.md para o passo a passo de cada uma)
# =====================================================================
NEXT_PUBLIC_SITE_URL=https://sambavest.com
LOJA_NOME="Samba Vest"

# --- WooCommerce (já usado pela loja) ---
NEXT_PUBLIC_WC_URL=https://api.sambavest.com
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
# Mesmo "Segredo" cadastrado nos webhooks do WooCommerce
WC_WEBHOOK_SECRET=
# Muda o pedido para "Concluído" quando o rastreio chega (true/false)
WC_CONCLUIR_AO_ENVIAR=true

# --- Rotinas periódicas: senha do /api/cron/automacao (gere um texto aleatório longo) ---
CRON_SECRET=

# --- Upstash Redis (obrigatório para o Bling; Vercel → Storage → Upstash) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Bling ---
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
# Opcional: ID da loja "Site" cadastrada no Bling
BLING_LOJA_ID=
BLING_ENVIAR_PEDIDOS=true
BLING_EMITIR_NFE=false
BLING_SINCRONIZAR_ESTOQUE=false

# --- Melhor Envio ---
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_SANDBOX=false
MELHOR_ENVIO_USER_AGENT="Samba Vest (seu-email@dominio.com)"
MELHOR_ENVIO_CRIAR_ENVIOS=true
# Compra a etiqueta automaticamente com o saldo da carteira (true/false)
MELHOR_ENVIO_COMPRAR_ETIQUETA=false
# Client secret do aplicativo (Área Dev) — valida os webhooks em /api/webhooks/melhorenvio
MELHOR_ENVIO_WEBHOOK_SECRET=
# Serviços mostrados na cotação (IDs do Melhor Envio). "todos" mostra tudo.
# 1=PAC 2=SEDEX 17=Mini Envios 3=Jadlog .Package 4=Jadlog .Com
MELHOR_ENVIO_SERVICOS=1,2,17,3,4
# Agência de postagem por serviço, se a transportadora exigir (serviço:agência,...). Ex.: 3:12345,4:12345
MELHOR_ENVIO_AGENCIAS=
# Pacote (o mesmo na cotação e na etiqueta)
PESO_POR_PECA_KG=0.3
PESO_CAIXA_KG=0
CAIXA_LARGURA_CM=20
CAIXA_ALTURA_CM=10
CAIXA_COMPRIMENTO_CM=15
# Remetente (aparece na etiqueta). Preencha CPF ou CNPJ (+ IE).
CEP_ORIGEM=
REMETENTE_NOME="Samba Vest"
REMETENTE_TELEFONE=
REMETENTE_EMAIL=
REMETENTE_CPF=
REMETENTE_CNPJ=
REMETENTE_IE=
REMETENTE_ENDERECO=
REMETENTE_NUMERO=
REMETENTE_COMPLEMENTO=
REMETENTE_BAIRRO=
REMETENTE_CIDADE=
REMETENTE_UF=RJ

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Versão da Graph API da Meta (troque quando a Meta avisar que a versão vai sair do ar)
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_IDIOMA=pt_BR
WHATSAPP_TEMPLATE_PAGO=pagamento_aprovado
WHATSAPP_TEMPLATE_ENVIADO=pedido_enviado
WHATSAPP_TEMPLATE_PIX_LEMBRETE=lembrete_pix
# Deixe vazio para não mandar "pedido recebido" no WhatsApp
WHATSAPP_TEMPLATE_RECEBIDO=
AVISAR_PEDIDO_RECEBIDO=false

# --- E-mail (Resend) ---
RESEND_API_KEY=
EMAIL_REMETENTE="Samba Vest <pedidos@sambavest.com>"
# Recebe alertas: novo pedido pago, etiqueta pronta, erros de automação
EMAIL_ADMIN=
AVISOS_EMAIL_EVENTOS=enviado,pixLembrete

# --- Lembrete de Pix não pago ---
PIX_LEMBRETE_APOS_HORAS=1
PIX_LEMBRETE_ATE_HORAS=24

# ATENDIMENTO PELO WHATSAPP (mensagens recebidas) — veja AUTOMACAO.md, seção 5
# =====================================================================
# Texto que você inventa e cola também no painel da Meta (Webhook → Token de verificação)
WHATSAPP_VERIFY_TOKEN=
# Meta → seu app → Configurações do app → Básico → Chave secreta do aplicativo
WHATSAPP_APP_SECRET=
# true se o número da loja continua no app WhatsApp Business (celular/PC) e também na API (coexistência)
WHATSAPP_COEXISTENCIA=false
# Quando te alertar: todas | humano (só quando precisa de você) | nenhum
# Vazio = "humano" com coexistência, "todas" sem
WHATSAPP_ALERTAS=
# Seu celular pessoal (55 + DDD + número) para receber alerta de mensagem nova
WHATSAPP_NUMERO_DONO=
# Template opcional para o alerta quando você não falou com o número da loja nas últimas 24h
# ({{1}} cliente, {{2}} trecho da mensagem). Vazio = o alerta vai só por e-mail nesse caso.
WHATSAPP_TEMPLATE_ALERTA_DONO=
# Não repete o alerta da mesma conversa antes de X minutos
WHATSAPP_ALERTA_INTERVALO_MIN=15
# Senha do painel https://SEU-SITE/atendimento
ATENDIMENTO_SENHA=

# --- Respostas automáticas (desligadas até você aprovar os textos) ---
WHATSAPP_RESPOSTAS_AUTOMATICAS=false
# Textos. Vazio = essa dúvida vai para você. Use \n para quebrar linha.
# Placeholders: {nome} {pedido} {status} {rastreio} {link} {site}
# Status do pedido (vazio = "Pedido #123: pagamento aprovado, em separação." + rastreio, se houver)
WHATSAPP_RESPOSTA_STATUS=
WHATSAPP_RESPOSTA_TAMANHOS=
# Vazio = "O prazo de envio é de 3 a 7 dias úteis."
WHATSAPP_RESPOSTA_PRAZO=
# Resposta para "oi", "bom dia"...
WHATSAPP_RESPOSTA_BOAS_VINDAS=
# Enviada quando a dúvida não é reconhecida e passa para uma pessoa
WHATSAPP_RESPOSTA_HUMANO=
# Depois de passar para uma pessoa, o robô fica quieto nesta conversa por X horas
WHATSAPP_HUMANO_SILENCIO_HORAS=12
=======
# --- Meta Ads: API de Conversões (compra enviada pelo servidor) ---
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=2779685332183949
META_CAPI_TOKEN=
# Só durante o teste no Gerenciador de Eventos; apague depois
META_TEST_EVENT_CODE=

# ==============================================================